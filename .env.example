# Datos del proyecto de Supabase (Configuración del proyecto → API).
# Ambos son públicos a propósito: el segundo es la clave "publishable",
# pensada para exponerse en el navegador. La seguridad real la hacen las
# políticas de RLS en las tablas, no mantener esto en secreto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave "service_role" (Configuración del proyecto → API → Project API keys).
# ESTA SÍ ES SECRETA: bypassea RLS. La usa únicamente
# scripts/ingest-precios-claros.mjs, corrido a mano en tu máquina — nunca la
# usa la app en producción, así que no hace falta cargarla en Vercel.
SUPABASE_SERVICE_ROLE_KEY=
